import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;

public class DatabaseInsertExample {

    // 1. Define database connection properties
    private static final String URL = "jdbc:mysql://localhost:3306/your_database_name";
    private static final String USER = "root";
    private static final String PASSWORD = "your_password";

    public static void main(String[] args) {
        // 2. Define the SQL INSERT query with placeholders (?)
        String sql = "INSERT INTO employees (name, email, salary) VALUES (?, ?, ?)";

        // 3. Establish connection and prepare statement using try-with-resources
        try (Connection connection = DriverManager.getConnection(URL, USER, PASSWORD);
             PreparedStatement preparedStatement = connection.prepareStatement(sql)) {
            
            System.out.println("Connected to the database successfully!");

            // 4. Bind values to the query parameters
            preparedStatement.setString(1, "Alice Smith");
            preparedStatement.setString(2, "alice.smith@example.com");
            preparedStatement.setDouble(3, 75000.00);

            // 5. Execute the query
            int rowsInserted = preparedStatement.executeUpdate();
            
            if (rowsInserted > 0) {
                System.out.println("A new row was inserted successfully!");
            }

        } catch (SQLException e) {
            System.err.println("Database connection or execution failed!");
            e.printStackTrace();
        }
    }
}
